{
  "name": "lab-cdt-ladder-api",
  "private": true,
  "version": "0.1.0",
  "description": "Explica mi escalera: one endpoint that explains a CDT ladder in plain Spanish. Session 2B: the validation pipeline and explanation view behind a private, buffered Lambda Function URL that calls the model.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "TZ=America/Bogota vitest run && TZ=UTC vitest run",
    "typecheck": "tsc --noEmit",
    "verify:vendor": "bash scripts/verify-vendor.sh",
    "eval:build": "esbuild src/eval/live.ts src/eval/replay.ts --bundle --platform=node --format=cjs --target=node22 --outdir=.eval --out-extension:.js=.cjs --log-level=warning",
    "eval:live": "npm run -s eval:build && node .eval/live.cjs",
    "eval:replay": "npm run -s eval:build && node .eval/replay.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-ssm": "3.1144.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
