# Local Claude Code settings — machine-specific, never committed
.claude/settings.local.json

# Secrets and environment
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build and deploy output
dist/
build/
.aws-sam/
.eval/
samconfig.toml

# What `npm run eval:replay` writes beside a stored run. A stored run is committed as it was
# measured, results.json and report.md, and a replay of it is never part of it.
evals/runs/*/report.replay.md

# OS and editor noise
.DS_Store
*.swp

# Logs
*.log
npm-debug.log*
